{
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": ["**/*.csproj"],
          "exclude": ["**/bin/**", "**/obj/**"]
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net10.0"
      },
      "enumSortOrder": "declaringOrder"
    }
  ],
  "build": {
    "content": [
      {
        "files": ["**/*.{md,yml}"],
        "exclude": ["_site/**", "releasing.md", "CONTRACTS_V5_DESIGN.md", "UPGRADING-5.6.md"]
      }
    ],
    "resource": [
      { "files": ["images/**"] }
    ],
    "output": "_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appName": "eQuantic.Core.Data",
      "_appTitle": "eQuantic.Core.Data",
      "_appFooter": "eQuantic.Core.Data — entity-ignorant persistence, honestly gated.",
      "_enableSearch": true,
      "pdf": false
    }
  }
}
