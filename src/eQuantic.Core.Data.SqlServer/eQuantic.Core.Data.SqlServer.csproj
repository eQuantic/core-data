<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>Native SQL Server implementation of the eQuantic.Core.Data contracts — Microsoft.Data.SqlClient directly over the shared relational engine, no Entity Framework: pushdown SQL from typed filters, atomic batched commits with OUTPUT INSERTED key backfill, keyset paging and SQL-DDL migrations.</Description>
        <AssemblyTitle>eQuantic.Core.Data.SqlServer</AssemblyTitle>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <AssemblyName>eQuantic.Core.Data.SqlServer</AssemblyName>
        <PackageId>eQuantic.Core.Data.SqlServer</PackageId>
        <PackageTags>eQuantic;Core;Data;Library;Repository;Pattern;SqlServer;SqlClient;Native</PackageTags>
        <PackageReleaseNotes>Native SQL Server (Microsoft.Data.SqlClient) implementation of the eQuantic.Core.Data contracts</PackageReleaseNotes>
        <PackageProjectUrl>https://github.com/eQuantic/core-data</PackageProjectUrl>
        <PackageOutputPath>../../artifacts/</PackageOutputPath>
        <RepositoryUrl>https://github.com/eQuantic/core-data</RepositoryUrl>
        <RepositoryType>Git</RepositoryType>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageIcon>Icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        
        <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.2" />
        <!--
          SqlClient 7 moved Entra ID authentication (Authentication=Active Directory ...) into its own package. A
          connection string that signed in with Entra ID on core-data 7.0 keeps working only with it referenced, so
          it comes with this provider; referencing it is all the driver needs.
        -->
        <PackageReference Include="Microsoft.Data.SqlClient.Extensions.Azure" Version="7.1.2" />
        <!--
          SqlClient brings System.Security.Cryptography.Pkcs from its net9.0 line on .NET 10, and an older line once
          carried GHSA-846f-f764-76mx; the .NET 10 one, with every fix, wins.
        -->
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
        <!--
          The floor the Entra ID package sets: it brings Azure.Identity, which needs the Microsoft.Extensions
          abstractions at 10.0.3, so 10.0.0 here would be a downgrade (NU1605).
        -->
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.3" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../eQuantic.Core.Data/eQuantic.Core.Data.csproj" />
        <ProjectReference Include="../eQuantic.Core.Data.Relational/eQuantic.Core.Data.Relational.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../eQuantic.Core.Data/Icon.png" Pack="true" PackagePath="Icon.png" />
        <None Include="../../LICENSE" Pack="true" PackagePath="" />
        <None Include="../../README.md" Pack="true" PackagePath="" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>$(AssemblyName).Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

</Project>
