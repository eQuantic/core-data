<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>Native Azure Cosmos DB implementation of the eQuantic.Core.Data contracts — the Cosmos SDK directly, no Entity Framework, with first-class container migrations and partition-key-aware writes.</Description>
        <AssemblyTitle>eQuantic.Core.Data.CosmosDb</AssemblyTitle>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- Interface-implementing members inherit their docs from the contracts; revisit with <inheritdoc/> as the provider matures. -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <AssemblyName>eQuantic.Core.Data.CosmosDb</AssemblyName>
        <PackageId>eQuantic.Core.Data.CosmosDb</PackageId>
        <PackageTags>eQuantic;Core;Data;Library;Repository;Pattern;CosmosDB;Azure;Native</PackageTags>
        <PackageReleaseNotes>Native Azure Cosmos DB SDK implementation of the eQuantic.Core.Data contracts</PackageReleaseNotes>
        <PackageProjectUrl>https://github.com/eQuantic/core-data</PackageProjectUrl>
        <PackageOutputPath>../../artifacts/</PackageOutputPath>
        <RepositoryUrl>https://github.com/eQuantic/core-data</RepositoryUrl>
        <RepositoryType>Git</RepositoryType>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageIcon>Icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.46.0" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
        <PackageReference Include="eQuantic.Linq.Expressions" Version="3.7.1" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../eQuantic.Core.Data/eQuantic.Core.Data.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="Icon.png" Pack="true" PackagePath="Icon.png" />
        <None Include="../../LICENSE" Pack="true" PackagePath="" />
        <None Include="../../README.md" Pack="true" PackagePath="" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>$(AssemblyName).Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

</Project>
